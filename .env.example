# HomeBot (UNI) — пример конфигурации. Скопируйте в .env и заполните.
# Файл читается и самим ботом, и systemd (EnvironmentFile), поэтому:
#   - комментарии только на отдельных строках (не после значения);
#   - значения без кавычек.
#
# Достаточно заполнить раздел 1. Всё остальное работает «из коробки», а большинство переключателей
# есть в самом боте (⚙️ Настройки, /tasks). Лишние и пустые строки можно смело удалять.

# =============================================================================
# 1. ОБЯЗАТЕЛЬНОЕ
# =============================================================================
# Токен от @BotFather
BOT_TOKEN=123456789:replace-me
# Ваш числовой Telegram ID (узнать: @userinfobot). Остальные пользователи игнорируются.
# Можно оставить пустым: при первом запуске бот напишет в журнал код, отправьте ему /start КОД.
ADMIN_ID=

# =============================================================================
# 2. ПО ЖЕЛАНИЮ: место, новости, курсы
# =============================================================================
# Часовой пояс; пусто — как у сервера, иначе UTC. Пример: Europe/Berlin
TIMEZONE=
# Знак валюты для финансов и цен на сайтах, например € или $
CURRENCY=
# Координаты для погоды (Open-Meteo, без ключа). Без координат погоды в сводке не будет. Пример: 52.52 и 13.40
WEATHER_LAT=
WEATHER_LON=
WEATHER_LABEL=
# Начальные ленты новостей через запятую; потом всё меняется в боте (⚙️ Настройки → Новости → Источники)
RSS_FEEDS=https://hnrss.org/frontpage,https://feeds.bbci.co.uk/news/world/rss.xml
# Официальные курсы НБУ к гривне в сводке, например USD,EUR (пусто — не показывать)
RATES_CURRENCIES=

# =============================================================================
# 3. ПРИЛОЖЕНИЯ
# =============================================================================
# Каждое включается, только если заданы адрес и доступ. Пустое значение — интеграция выключена.

# Docker: через прокси «только чтение» (его ставит deploy/update.sh)
DOCKER_URL=http://127.0.0.1:2375

# Speedtest Tracker: токен — в веб-интерфейсе /admin/api-tokens (права Read Results + Run Speedtest)
SPEEDTEST_URL=http://127.0.0.1:8084
SPEEDTEST_TOKEN=

# qBittorrent: логин и пароль от веб-интерфейса
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# AdGuard Home: логин и пароль от веб-интерфейса.
# Порт — тот, на котором открывается панель: обычно 8880 (если не открывается — попробуйте 3000)
ADGUARD_URL=http://127.0.0.1:8880
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Jellyfin: Панель управления → API-ключи → «+»
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
# Часть имени устройства, на котором запускать фильмы (пусто — первый открытый телевизор)
JELLYFIN_TV=

# 🎬 Кино. Ключи (Settings → General → API Key) update.sh подставляет сам из контейнеров radarr/sonarr.
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=
# Профиль качества для новых фильмов (как в Radarr); пусто — 1080p, если есть
RADARR_PROFILE=
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
SONARR_PROFILE=

# 💰 Финансы: Actual Budget. У Actual нет своего HTTP API, поэтому нужен контейнер-обёртка actual-http-api (см. README).
ACTUAL_URL=http://127.0.0.1:5007
# Ключ из переменной API_KEY контейнера actual-http-api
ACTUAL_API_KEY=
# Sync ID бюджета: Actual → Settings → Advanced settings
ACTUAL_BUDGET_ID=
# Счёт для трат (название или id); пусто — первый открытый счёт
ACTUAL_ACCOUNT=
# Только если бюджет зашифрован
ACTUAL_ENCRYPTION_PASSWORD=
# Знак валюты бюджета; пусто — CURRENCY
ACTUAL_CURRENCY=
# Показывать карточку с кнопкой «Записать» (рекомендуется: записанную трату через API не отменить)
EXPENSE_CONFIRM=true

# 🔎 Сайты: слежка за ценами и страницами через changedetection.io (кнопка «Сайты» в меню, /sites).
# Ключ API — в changedetection: Settings → API; update.sh подставит его сам, если контейнер называется changedetection.
CHANGEDETECTION_URL=http://127.0.0.1:5000
CHANGEDETECTION_API_KEY=
# Как часто бот спрашивает у changedetection, что изменилось (сами проверки сайтов — по его расписанию, 15 мин / 1 ч … в карточке)
SITES_INTERVAL_SEC=300
# Знак валюты в сообщениях о ценах; пусто — CURRENCY
SITES_CURRENCY=
# Новые слежки сразу открывать браузером (нужен браузерный контейнер в changedetection, см. README); иначе включается кнопкой в карточке
SITES_BROWSER=false

# 🖥 Веб-панель (Mini App внутри Telegram). Слушает только localhost; HTTPS-адрес даёт Tailscale Serve — см. README, «Веб-панель».
# Принимать заявки от других людей (без вашего «Принять» бот им не отвечает)
GUESTS_ENABLED=true
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8088
WEB_URL=

# 🎙 Голосовые → заметка / напоминание / расход. Нужен пакет faster-whisper (см. README), распознавание на CPU.
VOICE_MODEL=base
VOICE_LANGUAGE=ru
VOICE_MAX_SEC=180

# 📦 Каталог приложений: установка Jellyfin, Radarr, Sonarr, qBittorrent, changedetection из бота (🧩 Приложения → Каталог).
# Даёт боту право запускать контейнеры из белого списка. После изменения запустите deploy/update.sh.
CATALOG_ENABLED=false
# Где хранить данные приложений и медиатеку; от чьего имени (UID/GID) работают контейнеры
CATALOG_ROOT=/srv/uni
CATALOG_MEDIA=
CATALOG_PUID=1000
CATALOG_PGID=1000

# 💾 Бэкап: база и состояние бота раз в сутки в STATE_DIR/backups (⚙️ Настройки → 💾 Бэкап). .env в бэкап не попадает.
BACKUP_HOUR=4
BACKUP_KEEP=7
# Дополнительные файлы/папки в тот же архив (через запятую), например compose-файлы: /home/user/docker
BACKUP_PATHS=

# 💱 P2P-курс Binance (за сколько продать USDT). Ключи не нужны. Пороги, цель и сводка — в боте: /p2p
P2P_ENABLED=false
P2P_FIAT=UAH
P2P_ASSET=USDT
# Способы оплаты (идентификаторы Binance через запятую), например Monobank,PrivatBank. Пусто — любые
P2P_PAY_TYPES=
# Сумма сделки в валюте P2P_FIAT: цену берём только из объявлений, в чьи лимиты она входит. 0 — не фильтровать
P2P_AMOUNT=5000
P2P_INTERVAL_SEC=300
# Час вечерней сводки (по часовому поясу бота)
P2P_SUMMARY_HOUR=21

# =============================================================================
# 4. ТОНКАЯ НАСТРОЙКА — можно не трогать
# =============================================================================

# --- Общее -------------------------------------------------------------------
LOG_LEVEL=INFO
# Язык интерфейса: ru, en или uk (можно сменить и в панели). Language: ru, en or uk.
#LANGUAGE=ru
# 🆕 Новые версии с GitHub: stable, beta или off
#UPDATE_CHANNEL=stable
# 🔏 Ставить из чата только архивы с подписью автора
#UPDATE_REQUIRE_SIGNATURE=false
# Для systemd-юнита каталог состояния задаётся в самом .service (/var/lib/homebot).
# STATE_DIR=data

# --- Мониторинг сервера ------------------------------------------------------
# systemd-юниты для вкладки «Службы» (через запятую)
MONITORED_SERVICES=ssh,tailscaled,ollama
# Фоновые алерты (можно переключать кнопкой в боте; выбор из бота запоминается)
ALERTS_ENABLED=true
ALERT_INTERVAL_SEC=60
ALERT_COOLDOWN_SEC=1800
ALERT_CPU_PERCENT=90
ALERT_CPU_CONSECUTIVE=3
ALERT_RAM_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_TEMP_C=85
# История метрик для графиков
SAMPLE_INTERVAL_SEC=60
HISTORY_RETENTION_DAYS=30

# --- Безопасность и обслуживание ---------------------------------------------
# Уведомлять о каждом SSH-входе; неудачные попытки — сводкой раз в N секунд
SSH_WATCH_ENABLED=true
SSH_FAIL_REPORT_SEC=300
# Проблемы SMART и обновления безопасности
MAINTENANCE_ENABLED=true
# 💽 Ошибки диска, файловой системы, OOM и перегрев из журнала ядра
KERNEL_WATCH_ENABLED=true

# --- Управление сервером -----------------------------------------------------
# Службы, которые можно перезапускать кнопкой (с подтверждением). Права выдаёт deploy/update.sh.
# ssh и tailscaled сюда лучше не добавлять: перезапуск может оборвать удалённый доступ.
RESTART_SERVICES=ollama
# Кнопки «Перезагрузить» / «Выключить» сервер. После изменения запустите deploy/update.sh.
POWER_ENABLED=false
# 🛠 Ремонт сервера из бота и панели (/repair, «Самопроверка» → «Ремонт»): перезапуск бота, служб из RESTART_SERVICES,
# упавших задач и (при POWER_ENABLED) перезагрузка. Включается только здесь, каждое действие — по PIN (4–12 цифр),
# журнал — /var/lib/homebot/repair.log.
REPAIR_ENABLED=false
REPAIR_PIN=

# --- Docker ------------------------------------------------------------------
# Кнопка перезапуска контейнера (с подтверждением)
DOCKER_RESTART_ENABLED=true
# Уведомлять об остановке/unhealthy контейнеров
DOCKER_WATCH_ENABLED=true
# Контейнеры, о которых не сообщать (через запятую), например: romm,romm-db
DOCKER_IGNORE=
# Контейнеры, которые бот перезапускает сам при падении (до 3 раз в час), через запятую. Пусто — никакие
DOCKER_AUTOHEAL=
# При проблеме с контейнером модель в фоне разбирает журнал и дописывает причину в сообщение
DOCKER_DIAGNOSE=true

# --- Speedtest ---------------------------------------------------------------
# Предупреждать, если загрузка ниже N Мбит/с (0 — только о неудачных замерах)
SPEEDTEST_MIN_DOWN_MBPS=0
# Предупреждать, если скорость упала больше чем на N% от обычной (0 — выключено)
SPEEDTEST_DROP_PERCENT=50
# По воскресеньям вечером присылать недельный отчёт с графиком
SPEEDTEST_WEEKLY_REPORT=true

# --- Ollama (локальная модель) ----------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=300
# Сколько держать модель в RAM после ответа: 5m, 30s, 0 (сразу выгружать), -1 (вечно)
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_HISTORY=12
# Режим «размышлений» (Qwen3/Qwen3.5 и др.). false — отвечать сразу: на CPU это секунды вместо минут.
OLLAMA_THINK=false

# --- Новости ------------------------------------------------------------------
# Это начальные значения: дальше всё меняется прямо в боте (⚙️ Настройки → Новости).
NEWS_ENABLED=true
NEWS_INTERVAL_MIN=60
NEWS_COUNT=5
# Тихие часы ЧЧ-ЧЧ (ночью рассылки нет, утром — главное за ночь). Пусто — без тихих часов.
NEWS_QUIET_HOURS=23-8

# --- 🌐 Перевод заголовков и описаний -----------------------------------------
# LibreTranslate (локальный переводчик в Docker): если адрес задан, ВСЕ переводы идут через него,
# а модель занята только пересказом. Пусто — переводит модель Ollama.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Лёгкая модель Ollama только для перевода, например qwen3:1.7b — быстрее и меньше грузит CPU.
# Пусто — переводит та же модель, что в чате. Точное имя: ollama list
TRANSLATE_MODEL=
# Украинские новости тоже переводить на русский
TRANSLATE_UKRAINIAN=false

# --- 🎮 Бесплатные игры -------------------------------------------------------
GAMES_ENABLED=true
# Регион магазина Epic (влияет на список и цены)
GAMES_COUNTRY=US
# Раздачи Steam/GOG через gamerpower.com (у Steam нет официального списка раздач)
GAMES_EXTRA_SOURCES=true

# --- ☔ Умная погода (нужны WEATHER_LAT и WEATHER_LON) ---------------------------
WEATHER_ALERTS_ENABLED=true
WEATHER_FROST_C=-5
WEATHER_HEAT_C=35
# Порывы ветра, м/с
WEATHER_GUST_MS=17

# --- 🧹 Чистка диска (Jellyfin + Radarr/Sonarr) ----------------------------------
# Просмотренное моложе N дней не предлагать к удалению
CLEANUP_MIN_DAYS=3
